<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salf_customer_list" model="ir.ui.view">
        <field name="name">salf.customer.list</field>
        <field name="model">salf.customer</field>
        <field name="arch" type="xml">
            <list string="الزبائن">
                <field name="name"/>
                <field name="phone"/>
                <field name="qi_card_number"/>
                <field name="job_status"/>
                <field name="referred_by"/>
                <field name="loan_count"/>
            </list>
        </field>
    </record>
    <record id="view_salf_customer_form" model="ir.ui.view">
        <field name="name">salf.customer.form</field>
        <field name="model">salf.customer</field>
        <field name="arch" type="xml">
            <form string="بيانات الزبون">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loan" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="loan_count" widget="statinfo" string="السلفة"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="qi_card_number" password="True"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="job_status"/>
                            <field name="referred_by"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_salf_customer_search" model="ir.ui.view">
        <field name="name">salf.customer.search</field>
        <field name="model">salf.customer</field>
        <field name="arch" type="xml">
            <search string="بحث الزبائن">
                <field name="name"/>
                <field name="phone"/>
                <field name="qi_card_number"/>
                <field name="referred_by"/>
            </search>
        </field>
    </record>
    <record id="action_salf_customers" model="ir.actions.act_window">
        <field name="name">الزبائن</field>
        <field name="res_model">salf.customer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_salf_customer_search"/>
    </record>
</odoo>
